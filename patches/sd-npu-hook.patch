+    // ---- NPU experiment hook (env SD_NPU_DIR): write the DiT inputs of every step to files; SD_NPU_MODE=dump (default) also
+    // writes the velocity sd.cpp computed (to validate an external implementation), SD_NPU_MODE=extern waits for out_<n>.f32.
+    namespace npu_hook {
+        template <typename T>
+        inline void write_tensor(const std::string& dir, const char* name, int n, const sd::Tensor<T>& t) {
+            char path[1024];
+            snprintf(path, sizeof(path), "%s/%s_%d.bin", dir.c_str(), name, n);
+            FILE* f = fopen(path, "wb");
+            if (!f) return;
+            if (t.numel() > 0) fwrite(t.data(), sizeof(T), (size_t)t.numel(), f);
+            fclose(f);
+            snprintf(path, sizeof(path), "%s/%s_%d.shape", dir.c_str(), name, n);
+            f = fopen(path, "w");
+            if (!f) return;
+            for (auto d : t.shape()) fprintf(f, "%lld ", (long long)d);
+            fprintf(f, "\n");
+            fclose(f);
+        }
+        inline bool file_exists(const std::string& path) {
+            FILE* f = fopen(path.c_str(), "rb");
+            if (!f) return false;
+            fclose(f);
+            return true;
+        }
+        inline int& step_counter() {
+            static int n = 0;
+            return n;
+        }
+    }  // namespace npu_hook
